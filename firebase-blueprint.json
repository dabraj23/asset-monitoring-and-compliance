{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Checklist": {
      "title": "Checklist",
      "description": "A generated inspection checklist",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "categoryName": { "type": "string" },
        "items": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "categoryName", "items", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    },
    "/checklists/{checklistId}": {
      "schema": { "$ref": "Checklist" },
      "description": "Saved checklists"
    }
  }
}
