# Bind locally by default. Put a TLS reverse proxy in front before any remote pilot.
HOST="127.0.0.1"
PORT="3000"
# Optional fixed first-run token. If absent, a random token is printed in the server terminal.
# INITIAL_ADMIN_TOKEN="set-a-one-time-setup-token"

# Optional server-managed Gemini credentials. A key can also be tested and activated for the current server session from Settings.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional override. Live DOSH checks use this official MyKKP public endpoint by default.
DOSH_PUBLIC_API_BASE="https://data-mykkp.dosh.gov.my/api-dashboard/api/semakan"

# Optional filesystem locations for the disk-backed demo stores.
# VENDOR_DATA_DIR="C:/path/to/vendor-data"
# CONTRACT_DATA_DIR="C:/path/to/contract-data"
# PLATFORM_DATA_DIR="C:/path/to/platform-data"
# Phase 2 only: path to an external, access-controlled JSON source configuration.
# H2H_SOURCES_FILE="C:/secure/config/h2h-sources.json"
